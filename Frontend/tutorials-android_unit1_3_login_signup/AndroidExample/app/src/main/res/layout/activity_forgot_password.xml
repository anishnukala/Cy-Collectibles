<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot"
            android:textColor="#4A4A4A"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="#4A4A4A"
            android:layout_marginBottom="24dp"/>

        <!-- Image -->
        <ImageView
            android:layout_width="178dp"
            android:layout_height="169dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="32dp"
            android:scaleType="fitCenter"
            android:src="@drawable/forgot_password" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please enter your registered email ID"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We will send a verification code to your registered email ID"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginBottom="24dp"/>

        <!-- Email Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/bg_outline_rounded">

            <EditText
                android:id="@+id/forgot_email_edt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Email"
                android:textSize="20sp"
                android:inputType="textEmailAddress"
                android:background="@android:color/transparent"/>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_dialog_email"
                android:alpha="0.35"/>
        </LinearLayout>

        <!-- Reset Button -->
        <Button
            android:id="@+id/reset_password_btn"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:text="Reset password"
            android:textSize="22sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_red_rounded"
            android:backgroundTint="@null"
            app:backgroundTint="@null" />

        <!-- Back to Login -->
        <Button
            android:id="@+id/back_to_login_btn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="18dp"
            android:text="Back to Login"
            android:textSize="20sp"
            android:textColor="#4A4A4A"
            android:background="@drawable/bg_outline_rounded"
            android:backgroundTint="@null"/>


    </LinearLayout>

</ScrollView>