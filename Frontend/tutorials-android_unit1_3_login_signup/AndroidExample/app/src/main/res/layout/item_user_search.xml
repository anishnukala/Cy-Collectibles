<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/img_user_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:scaleType="centerCrop"
        android:src="@drawable/direct" />

    <TextView
        android:id="@+id/txt_user_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/img_user_avatar"
        android:layout_marginStart="14dp"
        android:text="username"
        android:textColor="#111111"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_user_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txt_user_username"
        android:layout_toEndOf="@id/img_user_avatar"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:text="buyer • email@example.com"
        android:textColor="#666666"
        android:textSize="13sp" />

    <View
        android:id="@+id/view_selected_marker"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_unread_dot"
        android:visibility="invisible" />

</RelativeLayout>