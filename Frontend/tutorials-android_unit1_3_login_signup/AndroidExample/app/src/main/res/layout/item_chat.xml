<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="92dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingStart="6dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/img_chat_avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentStart="true"
            android:layout_marginTop="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/direct" />

        <TextView
            android:id="@+id/txt_last_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text=""
            android:textColor="#8A8A8A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_chat_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/img_chat_avatar"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="54dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Chat Name"
            android:textColor="#111111"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_chat_members"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_chat_name"
            android:layout_toEndOf="@id/img_chat_avatar"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="54dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="buyer, admin, seller"
            android:textColor="#777777"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_last_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_chat_members"
            android:layout_toEndOf="@id/img_chat_avatar"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="54dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Last message"
            android:textColor="#444444"
            android:textSize="16sp" />

        <View
            android:id="@+id/view_unread_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/txt_last_message_time"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_unread_dot"
            android:visibility="gone" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:layout_marginStart="78dp"
        android:layout_marginEnd="4dp"
        android:background="#E0E0E0" />

</LinearLayout>