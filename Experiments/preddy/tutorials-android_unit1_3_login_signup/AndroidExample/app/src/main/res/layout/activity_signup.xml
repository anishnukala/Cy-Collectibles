<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    tools:context=".SignupActivity"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Signup Example"
        android:layout_gravity="center"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="80dp"
        android:textSize="30sp"
        android:textColor="#1F8A3A" >

    </TextView>

    <!-- Username -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="30dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username: "
            android:textSize="20sp"
            android:textColor="#333333">

        </TextView>

        <EditText
            android:id="@+id/signup_username_edt"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:hint="Enter username"
            android:textColor="#000000"
            android:textColorHint="#888888" >

        </EditText>
    </LinearLayout>

    <!-- Password -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password: "
            android:textSize="20sp"
            android:textColor="#333333" >

        </TextView>

        <EditText
            android:id="@+id/signup_password_edt"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:inputType="textPassword"
            android:hint="Enter password"
            android:textColor="#000000"
            android:textColorHint="#888888" >

        </EditText>
    </LinearLayout>

    <!-- Confirm Password -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="70dp"
            android:text="Confirm\nPassword: "
            android:textSize="20sp"
            android:textColor="#333333" >

        </TextView>

        <EditText
            android:id="@+id/signup_confirm_edt"
            android:layout_width="200dp"
            android:layout_height="70dp"
            android:inputType="textPassword"
            android:hint="Confirm password"
            android:textColor="#000000"
            android:textColorHint="#888888" >

        </EditText>
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="100dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/signup_login_btn"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="Login"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="#1976D2" >

        </Button>

        <Button
            android:id="@+id/signup_signup_btn"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="Signup"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="#1F8A3A" >

        </Button>
    </LinearLayout>

</androidx.appcompat.widget.LinearLayoutCompat>
